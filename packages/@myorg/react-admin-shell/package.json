{
  "name": "@myorg/react-admin-shell",
  "version": "1.0.0",
  "description": "后台管理外壳组合件：Layout（侧边/顶部导航，需要 react-router-dom）、GlobalAgent（可拖拽 AI 气泡 + 快捷键面板 + UniversalPageAgent 指令引擎，内部需要 antd/antd-icons/@ant-design/v5-patch-for-react-19/react-router-dom/@huggingface/transformers/onnxruntime-web/lodash/antd-form-builder/@myorg/react-core-hooks）、TestCenter（Python Playwright E2E 测试中心组件，可选依赖 lodash/prop-types）。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./styles": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "**/*style*"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run types",
    "types": "tsc --project ./tsconfig.build.json --emitDeclarationOnly --declaration --declarationDir ./dist --allowJs --checkJs false || true",
    "pack:local": "npm pack --pack-destination ../../../dist-local"
  },
  "keywords": [
    "react",
    "admin",
    "layout",
    "ai-agent",
    "test-center",
    "playwright",
    "antd",
    "glassmorphism"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@ant-design/icons": "^5 || ^6",
    "@ant-design/v5-patch-for-react-19": "^1",
    "@huggingface/transformers": "^3",
    "@myorg/react-core-hooks": "^1",
    "antd": "^5",
    "antd-form-builder": "^2",
    "lodash": "^4",
    "onnxruntime-web": "^1",
    "prop-types": "^15",
    "react": ">=18",
    "react-dom": ">=18",
    "react-router-dom": "^6 || ^7"
  },
  "peerDependenciesMeta": {
    "@ant-design/icons": { "optional": true },
    "@ant-design/v5-patch-for-react-19": { "optional": true },
    "@huggingface/transformers": { "optional": true },
    "antd": { "optional": true },
    "antd-form-builder": { "optional": true },
    "lodash": { "optional": true },
    "onnxruntime-web": { "optional": true },
    "prop-types": { "optional": true }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4",
    "esbuild": "^0.28.2",
    "sass": "^1.80",
    "typescript": "^5.6",
    "vite": "^5 || ^8 || ^9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/react-admin-shell.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
