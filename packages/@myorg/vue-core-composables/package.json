{
  "name": "@myorg/vue-core-composables",
  "version": "1.0.0",
  "description": "通用 Vue 3 composables 集合：会话（Auth）/ 本地离线语音识别（Whisper）/ 摄像头扫码（命令式弹窗）。与 @myorg/react-core-hooks 功能一一对应。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run types",
    "types": "node -e \"require('node:fs').copyFileSync('src/index.d.ts','dist/index.d.ts')\"",
    "pack:local": "npm pack --pack-destination ../../../dist-local"
  },
  "keywords": [
    "vue",
    "vue3",
    "composables",
    "auth",
    "whisper",
    "speech-recognition",
    "qr-scanner"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.0.0",
    "qr-scanner": "^1.4.2"
  },
  "peerDependenciesMeta": {
    "qr-scanner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5 || ^6",
    "esbuild": "^0.28.2",
    "sass": "^1.80",
    "typescript": "^5.6",
    "vite": "^5 || ^8 || ^9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/vue-core-composables.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
