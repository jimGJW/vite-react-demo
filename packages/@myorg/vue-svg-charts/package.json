{
  "name": "@myorg/vue-svg-charts",
  "version": "1.0.0",
  "description": "零依赖纯 SVG 图表组件库（Vue 3 版本）：折线/柱状/饼图/雷达/进度环 + 多维/二级钻取 + 图标切换组合组件；样式全部带 CSS 变量 fallback，其他项目无需 CSS 变量即可显示 Indigo 玻璃态风格。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./styles": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "**/*style*"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run types",
    "types": "node -e \"require('node:fs').copyFileSync('src/index.d.ts','dist/index.d.ts')\"",
    "pack:local": "npm pack --pack-destination ../../../dist-local"
  },
  "keywords": [
    "vue",
    "vue3",
    "svg",
    "charts",
    "line-chart",
    "bar-chart",
    "pie-chart",
    "radar-chart",
    "gauge",
    "drill-down",
    "indigo"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5 || ^6",
    "esbuild": "^0.28.2",
    "sass": "^1.80",
    "typescript": "^5.6",
    "vue-tsc": "^2",
    "vite": "^5 || ^8 || ^9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/vue-svg-charts.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
