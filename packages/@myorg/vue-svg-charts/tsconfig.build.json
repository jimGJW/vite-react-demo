{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist",
    "outDir": "./dist",
    "strict": false,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "jsx": "preserve",
    "types": ["vue"]
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
