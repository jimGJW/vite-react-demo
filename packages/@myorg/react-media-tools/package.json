{
  "name": "@myorg/react-media-tools",
  "version": "1.0.0",
  "description": "媒体工具组件：QrScanBtn（调用摄像头扫二维码的按钮）+ useWebQrScanner Hook；VoiceInput（Whisper 录音输入组件）+ useWhisperRecorder Hook。peerDependencies：react、react-dom、qr-scanner（扫码用）。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./styles": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "**/*style*"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run types",
    "types": "tsc --project ./tsconfig.build.json --emitDeclarationOnly --declaration --declarationDir ./dist --allowJs --checkJs false || true",
    "pack:local": "npm pack --pack-destination ../../../dist-local"
  },
  "keywords": [
    "react",
    "qr-code",
    "qr-scanner",
    "voice-input",
    "whisper",
    "media",
    "microphone",
    "camera"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "@myorg/react-core-hooks": "^1",
    "react": ">=18",
    "react-dom": ">=18",
    "qr-scanner": "^1.4"
  },
  "peerDependenciesMeta": {
    "qr-scanner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@myorg/react-core-hooks": "^1",
    "@vitejs/plugin-react": "^4",
    "esbuild": "^0.28.2",
    "sass": "^1.80",
    "typescript": "^5.6",
    "vite": "^5 || ^8 || ^9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jimGJW/vite-react-demo.git",
    "directory": "packages/@myorg/react-media-tools",
    "homepage": "https://gitee.com/jim_gjw/vite-react-demo"
  },
  "publishConfig": {
    "access": "public"
  }
}
