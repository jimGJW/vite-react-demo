{
  "name": "@myorg/react-ui-basic",
  "version": "1.0.0",
  "description": "纯 React + 原生 SCSS 的通用 UI 组件包：主题(ThemeProvider/ThemeToggle/useTheme)、通知中心(NotificationProvider/NotificationDrawer/useNotification)、命令面板(CommandPalette)、数据表格(DataTable)、365 星辰周天大阵(StarArray + STARS 数据)；零业务依赖，消费 @myorg/react-styles-reset 的设计 token，未引入时会使用 CSS var 内置 fallback 默认值。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./styles": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "**/*style*"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run types",
    "types": "tsc --project ./tsconfig.build.json --emitDeclarationOnly --declaration --declarationDir ./dist --allowJs --checkJs false || true",
    "pack:local": "npm pack --pack-destination ../../../dist-local"
  },
  "keywords": [
    "react",
    "react-components",
    "ui",
    "theme",
    "notification",
    "command-palette",
    "data-table",
    "star-array",
    "glassmorphism",
    "indigo"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4",
    "esbuild": "^0.28.2",
    "sass": "^1.80",
    "typescript": "^5.6",
    "vite": "^5 || ^8 || ^9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/react-ui-basic.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
