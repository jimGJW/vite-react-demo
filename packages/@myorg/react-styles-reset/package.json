{
  "name": "@myorg/react-styles-reset",
  "version": "1.0.0",
  "description": "Indigo + Glassmorphism 设计系统的全局 CSS：:root 设计 token、body/#root 重置、标题/链接/code、细滚动条、prefers-reduced-motion；纯 CSS/SCSS，无 JS 依赖。",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./styles": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss",
    "**/*style*"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && npm run types",
    "types": "tsc --project ./tsconfig.build.json --emitDeclarationOnly --declaration --declarationDir ./dist --allowJs --checkJs false || true",
    "pack:local": "npm pack --pack-destination ../../../dist-local"
  },
  "keywords": [
    "react",
    "css",
    "scss",
    "design-tokens",
    "css-reset",
    "indigo",
    "glassmorphism"
  ],
  "author": "",
  "license": "MIT",
  "peerDependencies": {},
  "devDependencies": {
    "@vitejs/plugin-react": "^4",
    "esbuild": "^0.28.2",
    "sass": "^1.80",
    "typescript": "^5.6",
    "vite": "^5 || ^8 || ^9"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/react-styles-reset.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
