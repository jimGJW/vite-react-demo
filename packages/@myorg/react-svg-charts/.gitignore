# ========= npm 包发布忽略文件 =========
# 发布 tarball 只包含 dist/ 与 package.json / README.md / index.d.ts
# （此列表与 package.json 的 files[] 白名单共同作用，实际以 files 白名单为准）

# 源码（已构建到 dist/）
src/
tsconfig.build.json
vite.config.js
node_modules/

# 构建产物在发布前确认，如有必要可手动打包 tgz 发布（推荐）
dist-local/
*.tgz

# 开发配置
.vscode/
.idea/
.DS_Store
npm-debug.log*
yarn-debug.log*
yarn-error.log*
