{
  "name": "vite-react-demo",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "workspaces": [
    "packages/**/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "python tests/test_pages.py",
    "test:whisper": "node scripts/test-whisper.mjs",
    "pkg:charts:build": "cd packages/@myorg/react-svg-charts && npm run build",
    "pkg:charts:pack": "cd packages/@myorg/react-svg-charts && npm pack --pack-destination ../../../dist-local",
    "pkg:styles:build": "cd packages/@myorg/react-styles-reset && npm run build",
    "pkg:core:build": "cd packages/@myorg/react-core-hooks && npm run build",
    "pkg:ui:build": "cd packages/@myorg/react-ui-basic && npm run build",
    "pkg:media:build": "cd packages/@myorg/react-media-tools && npm run build",
    "pkg:shell:build": "cd packages/@myorg/react-admin-shell && npm run build",
    "pkg:vue-styles:build": "cd packages/@myorg/vue-styles-reset && npm run build",
    "pkg:vue-core:build": "cd packages/@myorg/vue-core-composables && npm run build",
    "pkg:vue-ui:build": "cd packages/@myorg/vue-ui-basic && npm run build",
    "pkg:vue-media:build": "cd packages/@myorg/vue-media-tools && npm run build",
    "pkg:vue-charts:build": "cd packages/@myorg/vue-svg-charts && npm run build",
    "pkg:vue-shell:build": "cd packages/@myorg/vue-admin-shell && npm run build",
    "pkg:all:build": "npm run pkg:styles:build && npm run pkg:core:build && npm run pkg:ui:build && npm run pkg:media:build && npm run pkg:shell:build && npm run pkg:charts:build && npm run pkg:vue-styles:build && npm run pkg:vue-core:build && npm run pkg:vue-ui:build && npm run pkg:vue-media:build && npm run pkg:vue-charts:build && npm run pkg:vue-shell:build"
  },
  "dependencies": {
    "@angular/animations": "^22.1.4",
    "@angular/build": "^22.1.6",
    "@angular/cdk": "^22.1.4",
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/compiler-cli": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/forms": "^22.1.4",
    "@angular/material": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@angular/platform-browser-dynamic": "^22.1.4",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@element-plus/icons-vue": "^2.3.2",
    "@huggingface/transformers": "^3.8.1",
    "@myorg/react-admin-shell": "workspace:*",
    "@myorg/react-core-hooks": "workspace:*",
    "@myorg/react-media-tools": "workspace:*",
    "@myorg/react-styles-reset": "workspace:*",
    "@myorg/react-svg-charts": "workspace:*",
    "@myorg/react-ui-basic": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.8",
    "antd": "^5.29.3",
    "antd-form-builder": "^2.1.4",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.5",
    "lodash": "^4.18.1",
    "onnxruntime-web": "^1.22.0",
    "prop-types": "^15.8.1",
    "qr-scanner": "^1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.6.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "vue": "^3.5.42",
    "vue-router": "^4.5.0",
    "@myorg/vue-styles-reset": "workspace:*",
    "@myorg/vue-core-composables": "workspace:*",
    "@myorg/vue-ui-basic": "workspace:*",
    "@myorg/vue-media-tools": "workspace:*",
    "@myorg/vue-svg-charts": "workspace:*",
    "@myorg/vue-admin-shell": "workspace:*",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.7.1",
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sass": "^1.87.0",
    "typescript": "~6.0.0",
    "vite": "^8.2.0"
  }
}
