{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "strict": false,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "types": []
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
