# ============ Node / 构建产物 ============
node_modules/
.pnp
.pnp.js
dist/
dist-local/
build/
coverage/
*.tsbuildinfo

# Vite / HMR 缓存
.vite/
.vitepress/

# ============ 包构建产物（但保留独立包 dist/ 供发布使用）============
# 主项目 build 产物：/dist/ 已在上面忽略
# packages 下子包的 dist 可以根据需要选择提交/不提交
# 如果想只在发布时构建、不把 dist 放进 git，去掉下面注释：
packages/*/*/dist/
packages/@myorg/*/dist/

# 打包临时文件
*.tgz
*.tar.gz

# ============ npm / pnpm / yarn ============
npm-debug.log*
yarn-debug.log*
yarn-error.log*
yarn.lock
package-lock.json.bak
pnpm-debug.log*
.lighthouseci/

# 锁文件必须入库：本机全局 gitignore（core.excludesFile）忽略了 package-lock.json，
# 但仓库级规则优先级更高——这里显式反选根锁文件，保证依赖可复现、CI 能跑 npm ci。
# 只反选仓库根目录这一个：子包内的零散 lock 属于误装产物，不应入库。
!/package-lock.json

# ============ 测试 ============
tests/playwright-report/
tests/test-results/
.playwright/
test-artifacts/

# ============ 编辑器 ============
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
AppleDouble
.LSOverride

# ============ 环境变量 ============
.env
.env.local
.env.*.local

# ============ Python E2E 产生的本地文件 ============
.Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
server.log

# ============ 临时快照 ============
tmp/
temp/

# ============ AI 助手 / 开发工具临时文件 ============
.workbuddy/
.trae/
.trae-cn/
trae-browser-screenshots/

# 临时类型检查验证目录（本地产物，不入库）
.tmptest/
