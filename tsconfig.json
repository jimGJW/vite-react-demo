{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
